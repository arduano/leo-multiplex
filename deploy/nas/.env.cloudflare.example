# Keep the existing Tailscale settings. The second listener has its own origin.
LEO_IMAGE=ghcr.io/arduano/leo-multiplex@sha256:<published-image-digest>
LEO_AUTH_MODE=tailscale
LEO_PUBLIC_ORIGIN=http://100.YOUR_NAS_IP:8444
LEO_GATEWAY_P2P_BIND=100.YOUR_NAS_IP:0
LEO_ACCESS_EMAIL=owner@example.com
LEO_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
LEO_ACCESS_AUDIENCE=<Access-application-AUD>
LEO_CLOUDFLARE_SUBNET=10.203.82.0/24
# compose.cloudflare.yaml sets LEO_CLOUDFLARE_PUBLIC_ORIGIN and the socket path.
# The tunnel token belongs in secrets/cloudflare-token (0600), never here.
